@inherits RazorSlice<ConditionRowModel>

<div class="condition">
    <input type="hidden" name="index" value="@Model.Index">
    <div class="condition-grid">
        <div class="field">
            <label>Field</label>
            <select name="Conditions[@Model.Index].Field"
                    hx-get="/rules/conditions/editor"
                    hx-target="closest .condition"
                    hx-swap="outerHTML"
                    hx-include="closest .condition">
                @foreach (var field in Model.Fields)
                {
                    <option value="@field.Value" selected="@(field.Value == AdminUi.FieldValue(Model.Field))">@field.Label</option>
                }
            </select>
        </div>

        <div class="field">
            <label>Operator</label>
            <select name="Conditions[@Model.Index].Operator"
                    hx-get="/rules/conditions/editor"
                    hx-target="closest .condition"
                    hx-swap="outerHTML"
                    hx-include="closest .condition">
                @foreach (var option in Model.Operators)
                {
                    <option value="@option.Value" selected="@(option.Value == AdminUi.OperatorValue(Model.Operator))">@option.Label</option>
                }
            </select>
        </div>

        <div class="field">
            <label>Name</label>
            @if (Model.Field == ConditionField.Header)
            {
                <input type="text" name="Conditions[@Model.Index].Name" value="@Model.Name" placeholder="X-Api-Client">
            }
            else if (Model.Field == ConditionField.Query)
            {
                <input type="text" name="Conditions[@Model.Index].Name" value="@Model.Name" placeholder="token">
            }
            else
            {
                <input type="text" name="Conditions[@Model.Index].Name" value="" disabled>
            }
        </div>
    </div>

    <div class="field">
        <label>Values</label>
        @if (Model.Field == ConditionField.Method)
        {
            <div class="button-row">
                @foreach (var method in AdminUi.HttpMethods)
                {
                    <label class="checkline">
                        <input type="checkbox" name="Conditions[@Model.Index].Values" value="@method" checked="@Model.Values.Any(value => string.Equals(value, method, StringComparison.OrdinalIgnoreCase))">
                        @method
                    </label>
                }
            </div>
        }
        else if (Model.Operator == ConditionOperator.Exists)
        {
            <span class="hint">No values needed for the “exists” operator.</span>
        }
        else
        {
            <textarea name="Conditions[@Model.Index].Values" placeholder="@(Model.Field == ConditionField.Path ? "/api/\n/static/**" : Model.Field == ConditionField.Host ? "app.example.com\n*.example.com" : "one value per line")">@Model.ValuesText</textarea>
            <span class="hint">One value per line. Values within a condition are alternatives.</span>
        }
    </div>

    <div class="condition-foot">
        <label class="checkline">
            <input type="checkbox" name="Conditions[@Model.Index].Negated" value="on" checked="@Model.Negated">
            Negate this condition
        </label>
        <button type="button" class="small secondary" hx-on:click="this.closest('.condition').remove()">Remove</button>
    </div>
</div>
