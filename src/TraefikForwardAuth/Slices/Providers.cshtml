@inherits RazorSlice<ProvidersPageModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="page-head">
    <div>
        <h1>Providers</h1>
        <p class="lede">OAuth providers available to forward-auth and to the default rule action.</p>
    </div>
</div>

<div class="table-wrap">
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Client ID</th>
            <th>Secret</th>
            <th class="actions"></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Providers.Count == 0)
        {
            <tr><td colspan="5" class="empty">No providers configured yet. Add one below.</td></tr>
        }
        @foreach (var provider in Model.Providers)
        {
            <tr>
                <td><a href="/providers/@provider.Name"><strong>@provider.Name</strong></a></td>
                <td>@provider.Label</td>
                <td class="mono">@provider.ClientId</td>
                <td>
                    @if (provider.HasSecret)
                    {
                        <span class="pill ok">Set</span>
                    }
                    else
                    {
                        <span class="pill bad">Not set</span>
                    }
                </td>
                <td class="actions"><a class="button small secondary" href="/providers/@provider.Name">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

<h2>Add a provider</h2>
<div class="form-actions">
    <a class="button secondary" href="/providers/google">+ Google</a>
    <a class="button secondary" href="/providers/oidc">+ OpenID Connect</a>
    <a class="button secondary" href="/providers/generic-oauth">+ Generic OAuth2</a>
</div>

@functions {
    public LayoutModel LayoutModel => Model.Layout;
}
