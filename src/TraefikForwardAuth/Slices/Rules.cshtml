@inherits RazorSlice<RulesPageModel>
@implements IUsesLayout<_Layout, LayoutModel>

<div class="page-head">
    <div>
        <h1>Rules</h1>
        <p class="lede">Rules run from top to bottom and the first match wins. If nothing matches, the default action from settings applies.</p>
    </div>
    <a class="button" href="/rules/new">New rule</a>
</div>

<div class="table-wrap">
    <table>
        <thead>
        <tr>
            <th class="nowrap">#</th>
            <th>Name</th>
            <th>Action</th>
            <th>Provider</th>
            <th>Status</th>
            <th>Summary</th>
            <th class="actions"></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Rules.Count == 0)
        {
            <tr><td colspan="7" class="empty">No rules yet. Every request uses the default action.</td></tr>
        }
        @for (var i = 0; i < Model.Rules.Count; i++)
        {
            var rule = Model.Rules[i];
            <tr class="@(rule.Enabled ? null : "rule-disabled")">
                <td class="nowrap muted">@(i + 1)</td>
                <td class="nowrap"><a href="/rules/@rule.Id"><strong>@rule.Name</strong></a></td>
                <td><span class="pill @(rule.Action == RuleAction.Allow ? "ok" : "accent")">@AdminUi.ActionLabel(rule.Action)</span></td>
                <td class="nowrap">@rule.Provider</td>
                <td class="nowrap status">
                    <form method="post" action="/rules/@rule.Id/toggle">
                        <input type="hidden" name="__RequestVerificationToken" value="@Model.Layout.AntiforgeryToken">
                        <button type="submit" class="pill @(rule.Enabled ? "ok" : null)" title="@(rule.Enabled ? "Click to disable" : "Click to enable")"><span class="dot"></span>@(rule.Enabled ? "Enabled" : "Disabled")</button>
                    </form>
                </td>
                <td class="rule-summary">@(await RenderPartialAsync(CodeText.Create(rule.Summary)))</td>
                <td class="actions">
                    <div class="row-actions">
                        <form method="post" action="/rules/@rule.Id/move">
                            <input type="hidden" name="__RequestVerificationToken" value="@Model.Layout.AntiforgeryToken">
                            <input type="hidden" name="direction" value="up">
                            <button type="submit" class="small secondary icon" title="Move up" disabled="@rule.IsFirst">↑</button>
                        </form>
                        <form method="post" action="/rules/@rule.Id/move">
                            <input type="hidden" name="__RequestVerificationToken" value="@Model.Layout.AntiforgeryToken">
                            <input type="hidden" name="direction" value="down">
                            <button type="submit" class="small secondary icon" title="Move down" disabled="@rule.IsLast">↓</button>
                        </form>
                        <a class="button small secondary" href="/rules/@rule.Id">Edit</a>
                        <form method="post" action="/rules/@rule.Id/delete" onsubmit="return confirm('Delete this rule and its per-rule access entries?')">
                            <input type="hidden" name="__RequestVerificationToken" value="@Model.Layout.AntiforgeryToken">
                            <button type="submit" class="small danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@functions {
    public LayoutModel LayoutModel => Model.Layout;
}
