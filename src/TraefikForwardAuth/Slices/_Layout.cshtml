@inherits RazorLayoutSlice<LayoutModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Title · Traefik Forward Auth</title>
    <link rel="stylesheet" href="@AdminAssets.CssUrl">
    <script src="@AdminAssets.HtmxUrl" defer></script>
</head>
<body>
<header class="site-header">
    <div class="container">
        <div class="brand-row">
            <a class="brand" href="/settings">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/>
                    <path d="M9 12l2 2 4-4"/>
                </svg>
                Traefik Forward Auth
            </a>
            <div class="account">
                <span>@Model.AdminEmail</span>
                <form method="post" action="/logout">
                    <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken">
                    <button type="submit" class="link">Log out</button>
                </form>
            </div>
        </div>
        <nav class="site-nav">
            <a href="/settings" class="@(Model.Active == "settings" ? "active" : null)">Settings</a>
            <a href="/providers" class="@(Model.Active == "providers" ? "active" : null)">Providers</a>
            <a href="/rules" class="@(Model.Active == "rules" ? "active" : null)">Rules</a>
            <a href="/access" class="@(Model.Active == "access" ? "active" : null)">Users &amp; access</a>
            <a href="/sessions" class="@(Model.Active == "sessions" ? "active" : null)">Sessions</a>
            <a href="/admin-sessions" class="@(Model.Active == "admin-sessions" ? "active" : null)">Admin sessions</a>
            <a href="/audit" class="@(Model.Active == "audit" ? "active" : null)">Audit</a>
        </nav>
    </div>
</header>
<main class="content container">
    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="banner @(Model.FlashIsError ? "banner-error" : "banner-ok")">@Model.Flash</div>
    }
    @await RenderBodyAsync()
</main>
</body>
</html>
