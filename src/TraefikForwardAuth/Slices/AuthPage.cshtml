@inherits RazorSlice<TraefikForwardAuth.Http.AuthPageModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>@Model.Title</title>
    <style>
        :root { color-scheme: light dark; --bg: #f6f7f9; --card: #fff; --text: #1b1f24; --muted: #5b6470; --border: #d8dde3; --accent: #2f6fde; }
        @@media (prefers-color-scheme: dark) { :root { --bg: #14171b; --card: #1c2128; --text: #e6e9ed; --muted: #9aa4b0; --border: #2d343d; --accent: #5b8ff0; } }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
        main { width: min(420px, calc(100vw - 32px)); background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 28px; }
        h1 { margin: 0 0 8px; font-size: 20px; }
        p { margin: 0 0 20px; color: var(--muted); }
        strong { color: var(--text); word-break: break-all; }
        a.button { display: inline-block; padding: 9px 16px; border-radius: 8px; background: var(--accent); color: #fff; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>
<main>
    <h1>@Model.Title</h1>
    <p>
        @Model.Message
        @if (!string.IsNullOrEmpty(Model.Email))
        {
            <br><span>Signed in as <strong>@Model.Email</strong>.</span>
        }
    </p>
    <a class="button" href="@Model.ActionHref">@Model.ActionLabel</a>
</main>
</body>
</html>
