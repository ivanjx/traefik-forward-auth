@inherits RazorSlice<AuditPageModel>
@implements IUsesLayout<_Layout, LayoutModel>

<h1>Audit log</h1>
<p class="lede">The 500 most recent administrative changes.</p>

<table>
    <thead>
    <tr>
        <th class="nowrap">Time</th>
        <th>Admin</th>
        <th>Action</th>
        <th>Entity</th>
        <th>Diff</th>
    </tr>
    </thead>
    <tbody>
    @if (Model.Entries.Count == 0)
    {
        <tr><td colspan="5" class="muted">No audit entries yet.</td></tr>
    }
    @foreach (var entry in Model.Entries)
    {
        <tr>
            <td class="nowrap">@AdminUi.Time(entry.CreatedAt)</td>
            <td>@entry.AdminEmail</td>
            <td class="mono">@entry.Action</td>
            <td class="mono">@entry.Entity</td>
            <td><pre>@entry.DiffJson</pre></td>
        </tr>
    }
    </tbody>
</table>

@functions {
    public LayoutModel LayoutModel => Model.Layout;
}
